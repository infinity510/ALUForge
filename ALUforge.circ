    <comp lib="9" loc="(1000,900)" name="Text">
      <a name="text" val="sign of MOV source register (selected by SRC)"/>
    </comp>
    <comp lib="9" loc="(1300,2700)" name="Text">
      <a name="text" val="DIV_EN = OP_DIV and not divide-by-zero"/>
    </comp>
    <comp lib="9" loc="(1400,1900)" name="Text">
      <a name="text" val="write enable of destination ADDR1 (only when OP_SUM)"/>
    </comp>
    <comp lib="9" loc="(170,610)" name="Text">
      <a name="text" val="constant zeros"/>
    </comp>
    <comp lib="9" loc="(2000,40)" name="Text">
      <a name="text" val="8. OUTPUT STAGE  -  write enables (MOV | LOAD) then (| SUM/MUL/DIV), data bus and sign bus"/>
    </comp>
    <comp lib="9" loc="(2150,1050)" name="Text">
      <a name="text" val="result sign bus (selected by OPCODE)"/>
    </comp>
    <comp lib="9" loc="(2150,1260)" name="Text">
      <a name="text" val="remainder value / sign (used by DIV)"/>
    </comp>
    <comp lib="9" loc="(2150,570)" name="Text">
      <a name="text" val="result data bus (selected by OPCODE)"/>
    </comp>
    <comp lib="9" loc="(250,80)" name="Text">
      <a name="text" val="1. INPUTS  (register values/signs become tunnels)"/>
    </comp>
    <comp lib="9" loc="(477,183)" name="Text">
      <a name="text" val="inst[15:3] = INST_HI"/>
    </comp>
    <comp lib="9" loc="(489,132)" name="Text">
      <a name="text" val="inst[2:0] = OPCODE"/>
    </comp>
    <comp lib="9" loc="(514,42)" name="Text">
      <a name="text" val="DECODE UNIT  -  sections: 1 inputs | 2 opcode decoder | 3 MOV | 4 LOAD | 5 SUM | 6 MUL | 7 DIV | 8 output stage (right side)"/>
    </comp>
    <comp lib="9" loc="(540,1150)" name="Text">
      <a name="text" val="ADDR = inst[5:3]"/>
    </comp>
    <comp lib="9" loc="(540,1250)" name="Text">
      <a name="text" val="VALUE = inst[14:6]"/>
    </comp>
    <comp lib="9" loc="(540,700)" name="Text">
      <a name="text" val="DST = inst[5:3]"/>
    </comp>
    <comp lib="9" loc="(540,800)" name="Text">
      <a name="text" val="SRC = inst[8:6]"/>
    </comp>
    <comp lib="9" loc="(700,1110)" name="Text">
      <a name="text" val="4. LOAD  (register &lt;- immediate value in instruction)"/>
    </comp>
    <comp lib="9" loc="(700,1380)" name="Text">
      <a name="text" val="5. SUM  (operand X, Y chosen by ADDR1/ADDR2 = inst[5:3], inst[8:6]; result written to ADDR1)"/>
    </comp>
    <comp lib="9" loc="(700,2300)" name="Text">
      <a name="text" val="6. MUL  (A x B, low byte is the result)"/>
    </comp>
    <comp lib="9" loc="(700,2520)" name="Text">
      <a name="text" val="7. DIV  (A / B, remainder goes to REM, divide-by-zero blocks the write)"/>
    </comp>
    <comp lib="9" loc="(700,620)" name="Text">
      <a name="text" val="3. MOV  (register -&gt; register copy: DST &lt;- SRC)"/>
    </comp>
    <comp lib="9" loc="(703,252)" name="Text">
      <a name="text" val="2. OPCODE DECODER   000=END 001=MOV 010=LOAD 011=SUM 100=MUL 101=DIV"/>
    </comp>
    <comp loc="(1000,1160)" name="LOAD">
      <a name="label" val="u_load"/>
    </comp>
    <comp loc="(1000,2360)" name="MULTIPLIER8">
      <a name="label" val="x_mul"/>
    </comp>
    <comp loc="(1000,2580)" name="DIV">
      <a name="label" val="x_div"/>
    </comp>
    <comp loc="(1000,700)" name="Move">
      <a name="label" val="u_move"/>
    </comp>
    <comp loc="(1500,1700)" name="SUM">
      <a name="label" val="x_sum"/>
    </comp>
